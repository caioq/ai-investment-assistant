# Postgres connection string used by Prisma (apps/api/prisma/schema.prisma) to reach
# the `db` (dev) or `db-test` (test) service defined in docker-compose.yml.
DATABASE_URL=

# Secret used to sign/verify JWTs issued by the auth module (apps/api/src/auth/),
# read via the custom passport-jwt extractor that pulls the token from the
# httpOnly `access_token` cookie.
JWT_SECRET=

# Anthropic Claude API key used by the advisor module to generate the
# strengths/risks/recommendations portfolio analysis.
ANTHROPIC_API_KEY=

# Base URL of the Next.js frontend (apps/web), used by the NestJS API's CORS
# config ({ origin: FRONTEND_URL, credentials: true }) so the browser can send
# the auth cookie cross-port in dev.
FRONTEND_URL=http://localhost:3000

# Base URL of the NestJS API (apps/api), used by the frontend's fetch wrapper
# (apps/web/lib/api-client.ts) to prefix every request. Must be prefixed with
# NEXT_PUBLIC_ to be readable from the browser (Next.js inlines it at build
# time); defaults to http://localhost:3001 when unset.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Per-IP throttle on POST /auth/login and POST /auth/register (apps/api/src/auth/).
# Max requests per client IP per window, and the window length in milliseconds;
# exceeding it returns 429. Defaults: 5 per 60000 ms. Test/CI environments set
# AUTH_THROTTLE_LIMIT=1000 because the e2e suites log in from one IP.
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000
